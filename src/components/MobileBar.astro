---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<div class="mobile-bar" role="region" aria-label="Quick contact">
  <a href={site.phone.href} class="mb-btn mb-call">
    <Icon name="phone" size={20} />
    <span>Call now</span>
  </a>
  <a href={site.sms} class="mb-btn mb-text">
    <Icon name="sms" size={20} />
    <span>Text us</span>
  </a>
  <a href="/contact-us/" class="mb-btn mb-quote">
    <span>Get a Quote</span>
    <Icon name="arrow-right" size={20} />
  </a>
</div>

<style>
  .mobile-bar {
    display: none;
  }
  @media (max-width: 860px) {
    .mobile-bar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1fr 1.35fr;
      gap: 0.5rem;
      padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom));
      background: rgba(10, 30, 44, 0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 -10px 30px -12px rgba(0, 0, 0, 0.4);
    }
  }
  .mb-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 48px;
    border-radius: 12px;
    font-family: var(--font-display);
    font-stretch: 104%;
    font-weight: 750;
    font-size: 0.95rem;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .mb-call,
  .mb-text {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .mb-call:hover,
  .mb-text:hover {
    color: #fff;
  }
  .mb-quote {
    color: var(--amber-ink);
    background: var(--amber);
  }
  .mb-quote:hover {
    color: var(--amber-ink);
  }
  @media (max-width: 360px) {
    .mb-text span,
    .mb-call span {
      display: none;
    }
    .mobile-bar {
      grid-template-columns: 56px 56px 1fr;
    }
  }
</style>
