---
// Wordmark + mark. `tone="light"` for dark backgrounds.
interface Props {
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className } = Astro.props;
---

<span class:list={['logo', `logo-${tone}`, className]}>
  <svg class="logo-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="10" class="logo-tile" />
    <path d="M9 19.5 20 10l11 9.5" class="logo-roof" />
    <path d="M8 26.5c2.4-2 4.8-2 7.2 0s4.8 2 7.2 0 4.8-2 7.2 0" class="logo-wave" />
    <path d="M8 31.5c2.4-2 4.8-2 7.2 0s4.8 2 7.2 0 4.8-2 7.2 0" class="logo-wave logo-wave-2" />
  </svg>
  <span class="logo-text">
    <span class="logo-word">Flood</span><span class="logo-word logo-word-2">Mitigators</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    line-height: 1;
  }
  .logo-mark {
    width: 40px;
    height: 40px;
    flex: none;
  }
  .logo-tile {
    fill: var(--navy);
  }
  .logo-roof {
    fill: none;
    stroke: var(--amber);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .logo-wave {
    fill: none;
    stroke: var(--water-bright);
    stroke-width: 2.8;
    stroke-linecap: round;
  }
  .logo-wave-2 {
    opacity: 0.55;
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    font-family: var(--font-display);
    font-weight: 850;
    text-transform: uppercase;
  }
  .logo-word {
    font-size: 1.12rem;
    font-stretch: 118%;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .logo-word-2 {
    font-size: 0.69rem;
    font-stretch: 125%;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--water-ink);
  }
  .logo-light .logo-tile {
    fill: rgba(255, 255, 255, 0.08);
    stroke: rgba(255, 255, 255, 0.16);
  }
  .logo-light .logo-word {
    color: #fff;
  }
  .logo-light .logo-word-2 {
    color: var(--water-bright);
  }
</style>
