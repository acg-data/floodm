---
import Icon from './Icon.astro';
import type { Crumb } from '../lib/schema';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, lede, crumbs = [] } = Astro.props;
---

<section class="page-hero section-dark">
  <div class="ph-bg" aria-hidden="true">
    <svg viewBox="0 0 1440 220" preserveAspectRatio="none">
      <path d="M0 120c120-40 240-40 360 0s240 40 360 0 240-40 360 0 240 40 360 0v100H0Z" class="w1" />
      <path d="M0 160c120-34 240-34 360 0s240 34 360 0 240-34 360 0 240 34 360 0v60H0Z" class="w2" />
    </svg>
  </div>
  <div class="container ph-inner">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="crumbs">
        <ol role="list">
          <li><a href="/">Home</a></li>
          {crumbs.map((c, i) => (
            <li>
              <Icon name="chevron-right" size={14} />
              {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(4rem, 3rem + 4vw, 6.5rem);
    background:
      radial-gradient(80% 120% at 100% 0%, rgba(29, 111, 168, 0.35), transparent 60%),
      var(--deep);
  }
  .ph-bg {
    position: absolute;
    inset: auto 0 0 0;
    height: 120px;
    pointer-events: none;
  }
  .ph-bg svg {
    width: 100%;
    height: 100%;
  }
  .w1 {
    fill: rgba(91, 178, 232, 0.07);
  }
  .w2 {
    fill: rgba(91, 178, 232, 0.08);
  }
  .ph-inner {
    position: relative;
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  h1 {
    max-width: 20ch;
    color: #fff;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: #8da3b3;
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .crumbs a {
    color: #b9c9d4;
    text-decoration: none;
  }
  .crumbs a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: #fff;
  }
</style>
