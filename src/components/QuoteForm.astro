---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { symptoms } from '../data/symptoms';

interface Props {
  id?: string;
  /** Pre-select a service (slug). Query-string ?service= also works. */
  service?: string;
  compact?: boolean;
}
const { id = 'quote', service, compact = false } = Astro.props;
const endpoint = site.formEndpoint;
---

<form
  class:list={['quote-form', { compact }]}
  id={id}
  data-quote-form
  data-endpoint={endpoint}
  data-email={site.email}
  data-phone={site.phone.display}
  data-phone-href={site.phone.href}
  action={endpoint || `mailto:${site.email}`}
  method="post"
  enctype={endpoint ? undefined : 'text/plain'}
  novalidate
>
  <div class="qf-grid">
    <div class="field">
      <label for={`${id}-name`}>Your name <span class="req" aria-hidden="true">*</span></label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
      <p class="err" data-err="name">Please tell us your name.</p>
    </div>
    <div class="field">
      <label for={`${id}-phone`}>Phone <span class="req" aria-hidden="true">*</span></label>
      <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
      <p class="err" data-err="phone">Please enter a phone number we can reach you at.</p>
    </div>
    <div class="field">
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email" />
      <p class="err" data-err="email">That email doesn’t look quite right.</p>
    </div>
    <div class="field">
      <label for={`${id}-zip`}>ZIP code or neighborhood <span class="req" aria-hidden="true">*</span></label>
      <input id={`${id}-zip`} name="location" type="text" autocomplete="postal-code" required />
      <p class="err" data-err="location">Where is the property?</p>
    </div>
    <div class="field span-2">
      <label for={`${id}-service`}>What do you need help with?</label>
      <div class="select-wrap">
        <select id={`${id}-service`} name="service" data-service-select>
          <option value="Not sure — help me figure it out">Not sure — help me figure it out</option>
          {services.map((s) => (
            <option value={s.name} data-slug={s.slug} selected={service === s.slug ? true : undefined}>{s.name}</option>
          ))}
        </select>
        <Icon name="chevron-down" size={18} class="select-chevron" />
      </div>
    </div>

    {!compact && (
      <fieldset class="field span-2">
        <legend>What are you seeing? <span class="opt">Pick any that apply</span></legend>
        <div class="chips">
          {symptoms.map((sym) => (
            <label class="chip-check">
              <input type="checkbox" name="issues" value={sym.label} data-issue={sym.id} />
              <span>{sym.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )}

    <div class="field span-2">
      <label for={`${id}-details`}>Anything else we should know?</label>
      <textarea id={`${id}-details`} name="details" rows={compact ? 3 : 4} placeholder="Where does the water collect? How long does it stay? Anything you’ve already tried?"></textarea>
    </div>

    <fieldset class="field">
      <legend>Evaluation preference</legend>
      <div class="segmented">
        <label><input type="radio" name="evaluation" value="On-site visit" checked /><span>On-site</span></label>
        <label><input type="radio" name="evaluation" value="Virtual (photos/video)" /><span>Virtual</span></label>
      </div>
    </fieldset>
    <fieldset class="field">
      <legend>Best way to reach you</legend>
      <div class="segmented">
        <label><input type="radio" name="contact_by" value="Call" checked /><span>Call</span></label>
        <label><input type="radio" name="contact_by" value="Text" /><span>Text</span></label>
        <label><input type="radio" name="contact_by" value="Email" /><span>Email</span></label>
      </div>
    </fieldset>

    <div class="hp" aria-hidden="true">
      <label>Leave this empty <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>
  </div>

  <div class="qf-submit">
    <button type="submit" class="btn btn-lg btn-block" data-submit>
      <span class="btn-label">Request my evaluation</span>
      <Icon name="arrow-right" />
    </button>
    <p class="qf-note">
      Prefer to talk? Call or text <a href={site.phone.href}>{site.phone.display}</a>. {site.hours.label} · {site.hours.emergency}.
    </p>
  </div>

  <div class="qf-status" role="status" aria-live="polite" data-status></div>
</form>

<style>
  .quote-form {
    display: grid;
    gap: 1.5rem;
  }
  .qf-grid {
    display: grid;
    gap: 1.1rem 1rem;
  }
  @media (min-width: 620px) {
    .qf-grid {
      grid-template-columns: 1fr 1fr;
    }
    .span-2 {
      grid-column: 1 / -1;
    }
  }
  .field {
    display: grid;
    gap: 0.4rem;
    border: 0;
    padding: 0;
    min-width: 0;
  }
  label,
  legend {
    font-weight: 650;
    font-size: 0.92rem;
    color: var(--ink);
    padding: 0;
  }
  legend {
    margin-bottom: 0.45rem;
  }
  .req {
    color: var(--danger);
  }
  .opt {
    font-weight: 500;
    color: var(--muted);
    margin-left: 0.35rem;
  }
  input[type='text'],
  input[type='tel'],
  input[type='email'],
  select,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 0.8rem 0.95rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 12px;
    background: #fff;
    font-size: 1rem; /* ≥16px prevents iOS zoom */
    line-height: 1.4;
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
    appearance: none;
  }
  textarea {
    resize: vertical;
    min-height: 110px;
  }
  input:hover,
  select:hover,
  textarea:hover {
    border-color: rgba(12, 26, 36, 0.38);
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--water);
    box-shadow: 0 0 0 4px rgba(29, 111, 168, 0.18);
  }
  .select-wrap {
    position: relative;
  }
  select {
    padding-right: 2.5rem;
    cursor: pointer;
  }
  .select-wrap :global(.select-chevron) {
    position: absolute;
    right: 0.9rem;
    top: 50%;
    translate: 0 -50%;
    pointer-events: none;
    color: var(--muted);
  }
  .err {
    display: none;
    font-size: 0.85rem;
    color: var(--danger);
    font-weight: 550;
  }
  .field.invalid input {
    border-color: var(--danger);
  }
  .field.invalid .err {
    display: block;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip-check {
    position: relative;
    font-weight: 550;
    font-size: 0.9rem;
  }
  .chip-check input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .chip-check span {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1.5px solid var(--line-strong);
    background: #fff;
    line-height: 1.3;
    transition: all 0.15s var(--ease);
  }
  .chip-check:hover span {
    border-color: var(--water);
  }
  .chip-check input:checked + span {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .chip-check input:focus-visible + span {
    outline: 3px solid var(--water-bright);
    outline-offset: 2px;
  }

  .segmented {
    display: flex;
    padding: 4px;
    gap: 4px;
    border-radius: 14px;
    background: var(--paper-2);
    border: 1px solid var(--line);
  }
  .segmented label {
    position: relative;
    flex: 1;
    font-weight: 600;
  }
  .segmented input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .segmented span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 10px;
    font-size: 0.95rem;
    transition: all 0.15s var(--ease);
  }
  .segmented input:checked + span {
    background: #fff;
    box-shadow: var(--shadow-sm);
    color: var(--water-ink);
  }
  .segmented input:focus-visible + span {
    outline: 3px solid var(--water-bright);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .qf-submit {
    display: grid;
    gap: 0.75rem;
  }
  .qf-note {
    font-size: 0.88rem;
    color: var(--muted);
    text-align: center;
  }
  .qf-note a {
    font-weight: 700;
    white-space: nowrap;
  }
  .qf-status:empty {
    display: none;
  }
  .qf-status {
    padding: 1rem 1.1rem;
    border-radius: 12px;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .qf-status.ok {
    background: rgba(28, 122, 76, 0.1);
    border: 1px solid rgba(28, 122, 76, 0.35);
    color: #11533a;
  }
  .qf-status.fail {
    background: rgba(180, 35, 24, 0.08);
    border: 1px solid rgba(180, 35, 24, 0.3);
    color: #7a1a12;
  }
  .quote-form.sent .qf-grid,
  .quote-form.sent .qf-submit {
    display: none;
  }
</style>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('[data-quote-form]');

  forms.forEach((form) => {
    const endpoint = form.dataset.endpoint ?? '';
    const email = form.dataset.email ?? '';
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = submit.querySelector<HTMLElement>('.btn-label')!;

    // Pre-fill from ?service=slug&issues=a,b (Drainage Checkup / service pages).
    const params = new URLSearchParams(location.search);
    const slug = params.get('service');
    if (slug) {
      const opt = form.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(slug)}"]`);
      if (opt) opt.selected = true;
    }
    (params.get('issues') ?? '')
      .split(',')
      .filter(Boolean)
      .forEach((id) => {
        const box = form.querySelector<HTMLInputElement>(`input[data-issue="${CSS.escape(id)}"]`);
        if (box) box.checked = true;
      });

    const fieldOf = (name: string) => form.querySelector<HTMLInputElement>(`[name="${name}"]`);
    const setInvalid = (name: string, bad: boolean) => fieldOf(name)?.closest('.field')?.classList.toggle('invalid', bad);

    const validate = () => {
      const name = fieldOf('name')!.value.trim();
      const phone = fieldOf('phone')!.value.replace(/\D/g, '');
      const mail = fieldOf('email')!.value.trim();
      const loc = fieldOf('location')!.value.trim();
      const checks: [string, boolean][] = [
        ['name', name.length < 2],
        ['phone', phone.length < 10],
        ['email', mail.length > 0 && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail)],
        ['location', loc.length < 3],
      ];
      checks.forEach(([n, bad]) => setInvalid(n, bad));
      const firstBad = checks.find(([, bad]) => bad);
      if (firstBad) fieldOf(firstBad[0])?.focus();
      return !firstBad;
    };

    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.closest('.field.invalid')) el.closest('.field')!.classList.remove('invalid');
    });

    const summary = (data: FormData) => {
      const issues = data.getAll('issues').join('; ');
      return [
        `Name: ${data.get('name')}`,
        `Phone: ${data.get('phone')}`,
        `Email: ${data.get('email') || '—'}`,
        `Location: ${data.get('location')}`,
        `Service: ${data.get('service')}`,
        `Seeing: ${issues || '—'}`,
        `Evaluation: ${data.get('evaluation')}`,
        `Contact by: ${data.get('contact_by')}`,
        '',
        `${data.get('details') || ''}`,
      ].join('\n');
    };

    const done = (html: string, ok = true) => {
      status.className = `qf-status ${ok ? 'ok' : 'fail'}`;
      status.innerHTML = html;
      if (ok) form.classList.add('sent');
      status.setAttribute('tabindex', '-1');
      status.focus({ preventScroll: false });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      const data = new FormData(form);
      if (data.get('company_website')) return; // bot

      const phoneLink = `<a href="${form.dataset.phoneHref}"><strong>${form.dataset.phone}</strong></a>`;

      if (!endpoint) {
        const subject = `Drainage evaluation request — ${data.get('name')}`;
        location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(summary(data))}`;
        done(
          `<strong>Almost done — your email app should open with your request filled in. Just hit send.</strong><br />If nothing opened, call or text ${phoneLink} or email <a href="mailto:${email}">${email}</a>.`,
        );
        return;
      }

      submit.disabled = true;
      label.textContent = 'Sending…';
      try {
        data.append('_subject', `Drainage evaluation request — ${data.get('name')}`);
        data.append('summary', summary(data));
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        location.href = '/thank-you/';
      } catch {
        submit.disabled = false;
        label.textContent = 'Request my evaluation';
        done(`Sorry — that didn’t go through. Please call or text ${phoneLink} and we’ll take care of you right away.`, false);
      }
    });
  });
</script>
