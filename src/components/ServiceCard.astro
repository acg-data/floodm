---
import Icon from './Icon.astro';
import { servicePath, type Service } from '../data/services';

interface Props {
  service: Service;
  headingLevel?: 'h3' | 'h4';
}
const { service, headingLevel: H = 'h3' } = Astro.props;
---

<article class="service-card">
  <span class="sc-icon"><Icon name={service.icon} size={28} /></span>
  <H class="sc-title">
    <a href={servicePath(service)}>{service.name}</a>
  </H>
  <p>{service.summary}</p>
  <span class="sc-more" aria-hidden="true">
    Learn more <Icon name="arrow-right" size={18} />
  </span>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .service-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: rgba(29, 111, 168, 0.35);
  }
  .service-card:focus-within {
    outline: 3px solid var(--water-bright);
    outline-offset: 3px;
  }
  .sc-icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: var(--mist);
    color: var(--water-ink);
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .service-card:hover .sc-icon {
    background: var(--navy);
    color: var(--water-bright);
  }
  .sc-title {
    font-size: 1.3rem;
    margin-top: 0.35rem;
  }
  .sc-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .sc-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .sc-title a:focus-visible {
    outline: none;
  }
  p {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.55;
  }
  .sc-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--water-ink);
  }
  .sc-more :global(svg) {
    transition: transform 0.2s var(--ease);
  }
  .service-card:hover .sc-more :global(svg) {
    transform: translateX(4px);
  }
  @media (max-width: 600px) {
    .service-card {
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 0.35rem 1rem;
      padding: 1.15rem;
    }
    .sc-icon {
      grid-row: span 3;
      width: 48px;
      height: 48px;
      border-radius: 12px;
    }
    .sc-title {
      margin-top: 0;
      font-size: 1.15rem;
    }
    p {
      font-size: 0.93rem;
    }
    .sc-more {
      padding-top: 0.15rem;
    }
  }
</style>
