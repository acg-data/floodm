---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  body?: string;
  service?: string;
}
const {
  title = 'Get ahead of the next Houston storm.',
  body = 'Tell us what’s happening in your yard. We’ll evaluate it on site or virtually and send a detailed, itemized proposal.',
  service,
} = Astro.props;
const quoteHref = service ? `/contact-us/?service=${service}#quote` : '/contact-us/#quote';
---

<section class="cta-band">
  <div class="container">
    <div class="cta-card" data-reveal>
      <div class="cta-rain" aria-hidden="true"></div>
      <div class="cta-copy">
        <h2>{title}</h2>
        <p>{body}</p>
      </div>
      <div class="cta-actions on-dark">
        <a href={quoteHref} class="btn btn-lg">Get my drainage plan <Icon name="arrow-right" /></a>
        <a href={site.phone.href} class="btn btn-lg btn-ghost"><Icon name="phone" /> {site.phone.display}</a>
        <p class="cta-meta"><Icon name="clock" size={16} /> {site.hours.label} · {site.hours.emergency}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--section);
  }
  .cta-card {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 1.2rem + 3.5vw, 4rem);
    border-radius: 28px;
    color: #fff;
    background:
      radial-gradient(70% 120% at 0% 100%, rgba(29, 111, 168, 0.55), transparent 60%),
      radial-gradient(60% 90% at 100% 0%, rgba(244, 166, 42, 0.18), transparent 60%),
      var(--navy);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 960px) {
    .cta-card {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .cta-rain {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      105deg,
      transparent 0 22px,
      rgba(255, 255, 255, 0.035) 22px 23px
    );
    pointer-events: none;
  }
  .cta-copy,
  .cta-actions {
    position: relative;
  }
  h2 {
    font-size: var(--step-4);
    color: #fff;
  }
  .cta-copy p {
    margin-top: 1rem;
    font-size: var(--step-1);
    color: #c4d4df;
    max-width: 52ch;
  }
  .cta-actions {
    display: grid;
    gap: 0.75rem;
  }
  .cta-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: #a9bccb;
    text-align: center;
  }
  @media (max-width: 400px) {
    .cta-actions .btn {
      white-space: normal;
    }
  }
</style>
