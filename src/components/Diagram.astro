---
// Hand-built cross-section diagrams. Numbered amber markers in the SVG match
// the HTML legend underneath, so labels stay readable on any screen size.
import type { DiagramName } from '../data/services';

interface Props {
  name: DiagramName;
  caption?: string;
  compact?: boolean;
  class?: string;
}

const { name, caption, compact = false, class: className } = Astro.props;

const legends: Record<DiagramName, { title: string; items: string[] }> = {
  yard: {
    title: 'How we move water off a Houston lot',
    items: [
      'Downspouts tie into a buried solid pipe instead of dumping at the slab',
      'A French drain intercepts water before it reaches the foundation',
      'Catch basins collect water from low spots in the yard',
      'Everything leaves the property through a curb outlet',
    ],
  },
  'french-drain': {
    title: 'Inside a French drain',
    items: [
      'Surface water soaks through the turf cap',
      'Groundwater seeps in from the surrounding clay',
      'Filter fabric keeps soil out of the stone',
      'Washed gravel moves water down fast',
      'Perforated pipe carries it to the outlet',
    ],
  },
  'sump-pump': {
    title: 'How a yard sump system works',
    items: [
      'Yard drains feed the basin by gravity',
      'A buried basin collects the water below grade',
      'The float switch starts the pump as the level rises',
      'A check valve stops water from draining back',
      'The discharge line pushes water out to the curb',
    ],
  },
  culvert: {
    title: 'A driveway culvert, done right',
    items: [
      'Driveway surface built to carry vehicles',
      'Backfill compacted in lifts so the pipe stays put',
      'Pipe sized to the ditch so it doesn’t choke the flow',
      'Set on the ditch flow line — no dam, no silt trap',
    ],
  },
  'hydro-jet': {
    title: 'How hydro jetting clears a line',
    items: [
      'High-pressure hose feeds the jetting nozzle',
      'Nozzle runs at 3,000–8,000 PSI, matched to the pipe',
      'Rear jets scour the walls and pull the nozzle forward',
      'Roots and sediment are cut loose and flushed out',
    ],
  },
};

const legend = legends[name];
const id = `dg-${name}`;
---

<figure class:list={['diagram', { compact }, className]}>
  <div class="diagram-art">
    {name === 'yard' && (
      <svg viewBox="0 0 760 420" role="img" aria-labelledby={`${id}-t`}>
        <title id={`${id}-t`}>{legend.title}</title>
        <defs>
          <pattern id={`${id}-clay`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
            <line x1="0" y1="0" x2="0" y2="14" class="hatch" />
          </pattern>
          <pattern id={`${id}-gravel`} width="12" height="12" patternUnits="userSpaceOnUse">
            <circle cx="3" cy="3" r="2.4" class="pebble" />
            <circle cx="9" cy="8.5" r="2.1" class="pebble" />
          </pattern>
        </defs>

        <g class="rain">
          {Array.from({ length: 16 }, (_, i) => (
            <line x1={30 + i * 46} y1={18 + (i % 3) * 14} x2={22 + i * 46} y2={42 + (i % 3) * 14} />
          ))}
        </g>

        <path d="M0 250 L330 250 L640 262 L640 292 L760 292 L760 420 L0 420 Z" class="soil" />
        <path d="M0 250 L330 250 L640 262 L640 292 L760 292 L760 420 L0 420 Z" fill={`url(#${id}-clay)`} />
        <path d="M0 250 L330 250 L640 262" class="grass" />
        <path d="M640 262 V292 H760" class="ground-line" />
        <rect x="640" y="292" width="120" height="14" class="street" />
        <text x="22" y="398" class="d-label">HOUSTON CLAY</text>

        <!-- French drain trench -->
        <path d="M22 250 H76 L72 322 H26 Z" fill={`url(#${id}-gravel)`} class="trench" />
        <path d="M27 256 H71 L67 317 H31 Z" class="fabric" />
        <circle cx="49" cy="303" r="11" class="pipe-x" />
        <path d="M40 307 a11 11 0 0 0 18 0" class="pipe-water" />
        <path d="M120 300 q-18 2 -40 0" class="seep" />
        <path d="M118 278 q-18 2 -38 0" class="seep" />

        <!-- House -->
        <path d="M110 238 V142 H310 V238" class="house" />
        <path d="M92 144 L210 72 L328 144" class="roof" />
        <rect x="104" y="238" width="212" height="13" class="slab" />
        <rect x="190" y="186" width="32" height="52" rx="2" class="house-detail" />
        <rect x="132" y="164" width="36" height="32" rx="2" class="house-detail" />
        <rect x="244" y="164" width="36" height="32" rx="2" class="house-detail" />
        <rect x="318" y="140" width="18" height="9" rx="2" class="gutter" />

        <!-- Downspout + buried line -->
        <path d="M332 149 V262 Q332 272 342 272 L640 286" class="pipe-shell" />
        <path d="M332 149 V262 Q332 272 342 272 L640 286" class="pipe-core" />
        <path d="M332 149 V262 Q332 272 342 272 L640 286" class="flow flow-line" />
        <path d="M640 286 q22 0 34 6 h50" class="flow flow-out" />

        <!-- Catch basin -->
        <rect x="489" y="257" width="26" height="32" class="basin" />
        <rect x="485" y="253" width="34" height="6" rx="1" class="grate" />
        <path d="M502 222 v24 m-7 -8 7 8 7 -8" class="arrow" />

        <!-- Surface water moving away from the slab -->
        <path d="M352 238 h56 m-9 -6 9 6 -9 6" class="arrow" />
        <path d="M410 242 h56 m-9 -6 9 6 -9 6" class="arrow arrow-soft" />

        <g class="markers">
          <g transform="translate(356 196)"><circle r="14" /><text y="5">1</text></g>
          <g transform="translate(49 222)"><circle r="14" /><text y="5">2</text></g>
          <g transform="translate(540 230)"><circle r="14" /><text y="5">3</text></g>
          <g transform="translate(670 258)"><circle r="14" /><text y="5">4</text></g>
        </g>
      </svg>
    )}

    {name === 'french-drain' && (
      <svg viewBox="0 0 600 380" role="img" aria-labelledby={`${id}-t`}>
        <title id={`${id}-t`}>{legend.title}</title>
        <defs>
          <pattern id={`${id}-clay`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
            <line x1="0" y1="0" x2="0" y2="14" class="hatch" />
          </pattern>
          <pattern id={`${id}-gravel`} width="16" height="16" patternUnits="userSpaceOnUse">
            <circle cx="4" cy="4" r="3.4" class="pebble" />
            <circle cx="12" cy="11" r="3" class="pebble" />
            <circle cx="12.5" cy="2.5" r="1.6" class="pebble" />
          </pattern>
        </defs>
        <g class="rain">
          {Array.from({ length: 12 }, (_, i) => (
            <line x1={30 + i * 50} y1={14 + (i % 3) * 12} x2={22 + i * 50} y2={38 + (i % 3) * 12} />
          ))}
        </g>
        <rect x="0" y="110" width="600" height="270" class="soil" />
        <rect x="0" y="110" width="600" height="270" fill={`url(#${id}-clay)`} />
        <path d="M0 110 H600" class="grass" />
        <text x="20" y="362" class="d-label">HOUSTON CLAY</text>

        <path d="M206 110 H394 L372 334 H228 Z" class="trench-bg" />
        <path d="M216 128 H384 L364 324 H236 Z" fill={`url(#${id}-gravel)`} />
        <path d="M216 128 H384 L364 324 H236 Z" class="fabric" />
        <rect x="206" y="110" width="188" height="18" class="cap" />

        <circle cx="300" cy="288" r="30" class="pipe-x pipe-x-lg" />
        <path d="M274 302 a30 30 0 0 0 52 0 Z" class="pipe-water-fill" />
        {[[279, 306], [292, 314], [308, 314], [321, 306]].map(([cx, cy]) => <circle cx={cx} cy={cy} r="2.6" class="perf" />)}

        <path d="M300 54 v44 m-8 -10 8 10 8 -10" class="arrow" />
        <path d="M110 200 C150 200 180 210 214 226" class="seep seep-lg" />
        <path d="M110 260 C150 262 190 268 226 274" class="seep seep-lg" />
        <path d="M490 200 C450 200 420 210 386 226" class="seep seep-lg" />
        <path d="M490 260 C450 262 410 268 374 274" class="seep seep-lg" />

        <g class="markers">
          <g transform="translate(330 70)"><circle r="14" /><text y="5">1</text></g>
          <g transform="translate(110 230)"><circle r="14" /><text y="5">2</text></g>
          <g transform="translate(404 160)"><circle r="14" /><text y="5">3</text></g>
          <g transform="translate(300 200)"><circle r="14" /><text y="5">4</text></g>
          <g transform="translate(356 268)"><circle r="14" /><text y="5">5</text></g>
        </g>
      </svg>
    )}

    {name === 'sump-pump' && (
      <svg viewBox="0 0 600 400" role="img" aria-labelledby={`${id}-t`}>
        <title id={`${id}-t`}>{legend.title}</title>
        <defs>
          <pattern id={`${id}-clay`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
            <line x1="0" y1="0" x2="0" y2="14" class="hatch" />
          </pattern>
        </defs>
        <path d="M0 120 H540 V164 H600 V400 H0 Z" class="soil" />
        <path d="M0 120 H540 V164 H600 V400 H0 Z" fill={`url(#${id}-clay)`} />
        <path d="M0 120 H540" class="grass" />
        <path d="M540 120 V164 H600" class="ground-line" />
        <rect x="540" y="164" width="60" height="12" class="street" />
        <text x="20" y="382" class="d-label">LOW POINT OF THE LOT</text>

        <!-- Inlet -->
        <path d="M0 232 H250" class="pipe-shell" />
        <path d="M0 232 H250" class="pipe-core" />
        <path d="M0 232 H250" class="flow flow-line" />

        <!-- Basin -->
        <rect x="236" y="112" width="148" height="10" rx="2" class="lid" />
        <path d="M250 122 V356 a6 6 0 0 0 6 6 H364 a6 6 0 0 0 6 -6 V122" class="basin-wall" />
        <rect x="253" y="262" width="114" height="97" class="basin-water" />
        <path d="M253 262 q14 -5 28 0 t28 0 t28 0 t30 0" class="water-top" />
        <path d="M252 240 q8 4 10 18" class="seep" />

        <!-- Pump -->
        <rect x="276" y="300" width="48" height="56" rx="7" class="pump" />
        <rect x="284" y="292" width="32" height="10" rx="3" class="pump" />
        <path d="M344 330 V262" class="float-rod" />
        <circle cx="344" cy="262" r="9" class="float" />

        <!-- Discharge -->
        <path d="M300 292 V150 H540" class="pipe-shell" />
        <path d="M300 292 V150 H540" class="pipe-core" />
        <path d="M300 292 V150 H540" class="flow flow-line" />
        <path d="M540 150 q20 0 28 14 h30" class="flow flow-out" />
        <rect x="291" y="190" width="18" height="24" rx="3" class="valve" />

        <g class="markers">
          <g transform="translate(110 200)"><circle r="14" /><text y="5">1</text></g>
          <g transform="translate(214 300)"><circle r="14" /><text y="5">2</text></g>
          <g transform="translate(400 300)"><circle r="14" /><text y="5">3</text></g>
          <g transform="translate(334 202)"><circle r="14" /><text y="5">4</text></g>
          <g transform="translate(470 120)"><circle r="14" /><text y="5">5</text></g>
        </g>
      </svg>
    )}

    {name === 'culvert' && (
      <svg viewBox="0 0 640 340" role="img" aria-labelledby={`${id}-t`}>
        <title id={`${id}-t`}>{legend.title}</title>
        <defs>
          <pattern id={`${id}-clay`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
            <line x1="0" y1="0" x2="0" y2="14" class="hatch" />
          </pattern>
          <pattern id={`${id}-gravel`} width="12" height="12" patternUnits="userSpaceOnUse">
            <circle cx="3" cy="3" r="2.2" class="pebble" />
            <circle cx="9" cy="8.5" r="2" class="pebble" />
          </pattern>
        </defs>
        <path d="M0 258 L640 272 V340 H0 Z" class="soil" />
        <path d="M0 258 L640 272 V340 H0 Z" fill={`url(#${id}-clay)`} />
        <path d="M0 252 L170 255.7 L170 258 L0 258 Z M470 262.3 L640 266 V272 L470 268.3 Z" class="ditch-water" />
        <path d="M0 252 L170 255.7 M470 262.3 L640 266" class="flow flow-ditch" />

        <!-- Embankment -->
        <path d="M150 257.3 L226 152 H414 L490 264.7 Z" class="soil soil-fill" />
        <path d="M150 257.3 L226 152 H414 L490 264.7 Z" fill={`url(#${id}-clay)`} />
        <path d="M196 196 H444 M181 216 H458 M166 236 H472" class="lifts" />
        <rect x="214" y="138" width="212" height="16" rx="2" class="slab" />

        <!-- Car -->
        <g class="car">
          <path d="M262 136 v-14 a6 6 0 0 1 6 -6 h20 l14 -14 h46 l16 14 h14 a6 6 0 0 1 6 6 v14 Z" />
          <circle cx="286" cy="136" r="9" class="wheel" />
          <circle cx="358" cy="136" r="9" class="wheel" />
        </g>

        <!-- Bedding + pipe -->
        <path d="M170 258.4 L470 264.9 V276 L170 269.5 Z" fill={`url(#${id}-gravel)`} class="bedding" />
        <path d="M170 210 L470 216.5 V264.5 L170 258 Z" class="culvert-pipe" />
        <ellipse cx="170" cy="234" rx="10" ry="24" class="culvert-end" />
        <ellipse cx="470" cy="240.5" rx="10" ry="24" class="culvert-end" />
        <path d="M180 248 L460 254" class="flow flow-line" />
        <path d="M180 238 L460 244" class="flow flow-line flow-faint" />
        <path d="M0 258 L640 272" class="ground-line" />

        <g class="markers">
          <g transform="translate(450 128)"><circle r="14" /><text y="5">1</text></g>
          <g transform="translate(206 180)"><circle r="14" /><text y="5">2</text></g>
          <g transform="translate(320 205)"><circle r="14" /><text y="5">3</text></g>
          <g transform="translate(560 244)"><circle r="14" /><text y="5">4</text></g>
        </g>
      </svg>
    )}

    {name === 'hydro-jet' && (
      <svg viewBox="0 0 640 300" role="img" aria-labelledby={`${id}-t`}>
        <title id={`${id}-t`}>{legend.title}</title>
        <defs>
          <pattern id={`${id}-clay`} width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
            <line x1="0" y1="0" x2="0" y2="14" class="hatch" />
          </pattern>
        </defs>
        <rect x="0" y="0" width="640" height="300" class="soil" />
        <rect x="0" y="0" width="640" height="300" fill={`url(#${id}-clay)`} />
        <rect x="0" y="78" width="640" height="144" class="pipe-wall" />
        <rect x="0" y="90" width="640" height="120" class="pipe-inside" />

        <!-- Debris ahead of the nozzle -->
        <path d="M360 210 C380 196 400 202 420 192 C450 180 470 194 500 186 C540 176 580 190 640 180 V210 Z" class="sediment" />
        <path d="M420 90 C424 112 410 124 420 146 M470 90 C462 116 482 128 470 158 C466 170 476 176 472 186 M520 90 C528 108 514 128 526 150 M575 90 C568 110 586 132 572 160 M612 90 C618 104 604 118 614 138" class="roots" />

        <!-- Flushed debris behind -->
        {[[150, 198], [178, 202], [118, 204], [206, 199], [90, 201], [232, 203]].map(([cx, cy]) => <circle cx={cx} cy={cy} r="3" class="flake" />)}
        <path d="M250 196 h-60 m8 -6 -8 6 8 6" class="arrow arrow-soft" />

        <!-- Hose + nozzle -->
        <path d="M0 150 H262" class="hose" />
        <path d="M262 140 h22 l14 10 -14 10 h-22 Z" class="nozzle" />
        <path d="M268 140 L230 92 M268 160 L230 208 M276 140 L250 92 M276 160 L250 208" class="jet" />
        <path d="M298 150 H352 M296 146 L346 122 M296 154 L346 178" class="jet jet-fwd" />

        <g class="markers">
          <g transform="translate(120 128)"><circle r="14" /><text y="5">1</text></g>
          <g transform="translate(290 118)"><circle r="14" /><text y="5">2</text></g>
          <g transform="translate(206 112)"><circle r="14" /><text y="5">3</text></g>
          <g transform="translate(500 136)"><circle r="14" /><text y="5">4</text></g>
        </g>
      </svg>
    )}
  </div>

  <figcaption>
    <p class="diagram-title">{caption ?? legend.title}</p>
    <ol class="diagram-legend">
      {legend.items.map((item, i) => (
        <li><span class="n" aria-hidden="true">{i + 1}</span><span>{item}</span></li>
      ))}
    </ol>
  </figcaption>
</figure>

<style>
  .diagram {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .diagram-art {
    background:
      linear-gradient(180deg, #dcebf5 0%, #eef5f9 60%, #f5f8fa 100%);
    border-bottom: 1px solid var(--line);
  }
  .diagram-art svg {
    width: 100%;
    height: auto;
  }
  figcaption {
    padding: 1.1rem 1.25rem 1.3rem;
  }
  .diagram-title {
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.005em;
    margin-bottom: 0.75rem;
  }
  .diagram-legend {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem 1.25rem;
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.45;
  }
  @media (min-width: 640px) {
    .diagram:not(.compact) .diagram-legend {
      grid-template-columns: 1fr 1fr;
    }
  }
  .diagram-legend li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.6rem;
    align-items: start;
  }
  .n {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--amber);
    color: var(--amber-ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.78rem;
  }

  /* SVG styling */
  svg :global(.soil) {
    fill: #e8dfcf;
  }
  svg :global(.soil-fill) {
    fill: #e2d6c1;
  }
  svg :global(.hatch) {
    stroke: rgba(92, 64, 36, 0.16);
    stroke-width: 2;
  }
  svg :global(.grass) {
    fill: none;
    stroke: #6d9b62;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  svg :global(.ground-line) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  svg :global(.street) {
    fill: #5e6b74;
  }
  svg :global(.d-label) {
    font-family: var(--font-display);
    font-stretch: 120%;
    font-weight: 750;
    font-size: 15px;
    letter-spacing: 0.18em;
    fill: rgba(92, 64, 36, 0.55);
  }
  svg :global(.rain line) {
    stroke: var(--water);
    stroke-width: 2.4;
    stroke-linecap: round;
    opacity: 0.45;
  }
  svg :global(.house) {
    fill: #fff;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  svg :global(.roof) {
    fill: var(--navy);
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  svg :global(.slab),
  svg :global(.lid) {
    fill: #c9c4b8;
    stroke: var(--ink);
    stroke-width: 2;
  }
  svg :global(.house-detail) {
    fill: var(--mist);
    stroke: var(--ink);
    stroke-width: 2;
  }
  svg :global(.gutter) {
    fill: var(--ink-2);
  }
  svg :global(.pipe-shell) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 13;
    stroke-linejoin: round;
  }
  svg :global(.pipe-core) {
    fill: none;
    stroke: #fff;
    stroke-width: 8;
    stroke-linejoin: round;
  }
  svg :global(.flow-line) {
    fill: none;
    stroke: var(--water);
    stroke-width: 4;
    stroke-linecap: round;
  }
  svg :global(.flow-faint) {
    opacity: 0.4;
  }
  svg :global(.flow-out),
  svg :global(.flow-ditch) {
    fill: none;
    stroke: var(--water);
    stroke-width: 4;
    stroke-linecap: round;
  }
  svg :global(.ditch-water),
  svg :global(.basin-water) {
    fill: rgba(91, 178, 232, 0.4);
  }
  svg :global(.water-top) {
    fill: none;
    stroke: var(--water);
    stroke-width: 2.5;
  }
  svg :global(.trench),
  svg :global(.trench-bg) {
    fill: #d9d1c1;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  svg :global(.pebble) {
    fill: #a59c8b;
  }
  svg :global(.fabric) {
    fill: none;
    stroke: var(--water);
    stroke-width: 2.5;
    stroke-dasharray: 7 5;
    stroke-linejoin: round;
  }
  svg :global(.cap) {
    fill: #b99f7b;
  }
  svg :global(.pipe-x) {
    fill: #fff;
    stroke: var(--ink);
    stroke-width: 2.5;
  }
  svg :global(.pipe-x-lg) {
    stroke-width: 4;
  }
  svg :global(.pipe-water) {
    fill: none;
    stroke: var(--water);
    stroke-width: 3;
  }
  svg :global(.pipe-water-fill) {
    fill: rgba(91, 178, 232, 0.6);
  }
  svg :global(.perf) {
    fill: var(--ink);
  }
  svg :global(.seep) {
    fill: none;
    stroke: var(--water);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 3 6;
    opacity: 0.85;
  }
  svg :global(.seep-lg) {
    stroke-width: 3.5;
    stroke-dasharray: 4 8;
  }
  svg :global(.arrow) {
    fill: none;
    stroke: var(--water);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  svg :global(.arrow-soft) {
    opacity: 0.5;
  }
  svg :global(.basin),
  svg :global(.basin-wall) {
    fill: #fff;
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  svg :global(.grate) {
    fill: var(--ink-2);
  }
  svg :global(.pump) {
    fill: var(--navy);
    stroke: var(--ink);
    stroke-width: 2;
  }
  svg :global(.float-rod) {
    stroke: var(--ink);
    stroke-width: 2.5;
  }
