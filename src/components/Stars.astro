---
interface Props { label?: string }
const { label } = Astro.props;
---
<span class="review-stars" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  {Array.from({ length: 5 }, () => <svg viewBox="0 0 20 20" fill="currentColor"><path d="m10 1.5 2.6 5.3 5.9.9-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.1 5.9-.9z"/></svg>)}
</span>
