---
// Three-step process in the original design's style.
interface Props { steps?: { title: string; body: string; icon?: string; tagline?: string }[] }
const defaults = [
  { icon: 'i-house', title: 'Visit your property', body: 'We assess your yard in person, looking at the grading, downspouts, low spots and outlets to find where the water needs to go.', tagline: 'Onsite drainage assessment' },
  { icon: 'i-doc', title: 'Design your solution', body: 'You receive a property-specific drainage design, an itemized estimate and an installation timeline before approving the work.', tagline: 'Design · Proposal · Clear scope' },
  { icon: 'i-hat', title: 'Install, test and clean up', body: 'Our crew installs your drainage system, tests the flow of water, restores disturbed lawn and beds, and leaves the site clean.', tagline: 'Installation · Water testing · Cleanup' },
];
const icons = ['i-house', 'i-doc', 'i-hat'];
const { steps = defaults } = Astro.props;
---
<div class="steps">
  {steps.map((st, i) => (
    <div class="step-card">
      <div class="step-top"><span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><svg aria-hidden="true"><use href={`#${st.icon ?? icons[i] ?? 'i-check'}`} /></svg></div>
      <h3>{st.title}</h3>
      <p>{st.body}</p>
      {st.tagline && <span class="tagline">{st.tagline}</span>}
    </div>
  ))}
</div>
