---
const organizations = [
  { id: 'bbb', name: 'BBB Accredited Business', width: 300, height: 153 },
  { id: 'preferred-contractor', name: 'NDS Preferred Contractor', width: 800, height: 154 },
  { id: 'ghba', name: 'Greater Houston Builders Association', width: 138, height: 96, dark: true },
  { id: 'nahb', name: 'National Association of Home Builders', width: 138, height: 96, dark: true },
  { id: 'texas-builders', name: 'Texas Association of Builders', width: 300, height: 122, dark: true },
  { id: 'tfma', name: 'Texas Floodplain Management Association', width: 600, height: 593 },
  { id: 'scieca', name: 'South Central Chapter, International Erosion Control Association', width: 551, height: 305 },
  { id: 'common-ground', name: 'Common Ground Alliance', width: 259, height: 95 },
  { id: 'texas811', name: 'Texas 811', width: 432, height: 334 },
  { id: 'damage-prevention', name: 'Damage Prevention Council of Texas', width: 214, height: 218 },
  { id: 'soil-science', name: 'Soil Science Society of America', width: 403, height: 130, dark: true },
  { id: 'first-responder', name: 'Public Works First Responder', width: 600, height: 600 },
];
---
<section class="section credentials" id="credentials" aria-labelledby="credentialsH">
  <div class="wrap">
    <div class="credential-lead">
      <img class="nds-badge" src="/assets/source/nds-certified.webp" width="600" height="611" alt="NDS Professional Drainage Certified Contractor badge" loading="lazy" decoding="async" />
      <div><h2 id="credentialsH">The details behind<br>a job done right.</h2><p class="lede">Drainage training, careful planning and attention to what is underground. Our approach brings installation, soil, floodplain and damage-prevention knowledge together.</p><p class="credential-note">NDS Professional Drainage Certified Contractor</p></div>
    </div>
    <h3 class="industry-heading">Industry organizations &amp; safety resources</h3>
    <ul class="industry-logos">
      {organizations.map((org) => <li class:list={{ 'logo-on-navy': org.dark }}><img src={`/assets/source/${org.id}.webp`} width={org.width} height={org.height} alt="" loading="lazy" decoding="async" /><span>{org.name}</span></li>)}
    </ul>
  </div>
</section>
