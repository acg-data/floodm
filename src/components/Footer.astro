---
import { site } from '../data/site';
import { services, servicePath } from '../data/services';
import { googleBusiness } from '../data/google-business';
import { guides, tools, guidePath } from '../data/resources';

---

<footer class="footer">
  <div class="wrap">
    <div class="fbrand">
      <a class="brand" href="/" aria-label="Flood Mitigators home">
        <img class="mark" src="/assets/img/logo-mark-white.png" width="293" height="100" alt="" loading="lazy" decoding="async">
        <img class="word" src="/assets/img/logo-wordmark-white.png" width="345" height="100" alt="Flood Mitigators" loading="lazy" decoding="async">
      </a>
      <p class="tag">Houston yard drainage, from the first conversation to the final water test. Family-owned and Houston-operated.</p>
      <ul class="contact">
        <li><svg aria-hidden="true"><use href="#i-phone"/></svg><a class="ph" href={site.phone.href}>{site.phone.display}</a></li>
        <li><svg aria-hidden="true"><use href="#i-mail"/></svg><a class="em" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><svg aria-hidden="true"><use href="#i-clock"/></svg><span>{site.hours.label}<br /><a href="/emergency/">{site.emergency}</a></span></li>
        <li><svg aria-hidden="true"><use href="#i-pin"/></svg><a href={googleBusiness.url} target="_blank" rel="noopener">{site.address.street}<br />Houston, TX {site.address.postalCode}</a></li>
      </ul>
      <div class="social">
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Flood Mitigators on Facebook"><svg><use href="#i-fb"/></svg></a>
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Flood Mitigators on Instagram"><svg><use href="#i-ig"/></svg></a>
      </div>
    </div>
    <div><h3>Services</h3><ul>{services.map((s) => <li><a href={servicePath(s)}>{s.navName}</a></li>)}</ul></div>
    <div>
      <h3>Company</h3>
      <ul><li><a href="/about/">About &amp; Manny</a></li><li><a href="/our-work/">Our work</a></li><li><a href="/warranty-and-care/">Warranty &amp; care</a></li><li><a href="/contact/">Contact</a></li><li><a href="/emergency/">24/7 emergency</a></li><li><a href="/faq/">FAQ</a></li></ul>
    </div>
    <div>
      <h3>Resources</h3>
      <ul>
        {guides.slice(0, 3).map((g) => <li><a href={guidePath(g.slug)}>{g.title}</a></li>)}
        {tools.map((t) => <li><a href={t.href}>{t.title}</a></li>)}
        <li><a href="/resources/">All resources</a></li>
      </ul>
    </div>
    <div class="legal"><span>© {new Date().getFullYear()} Flood Mitigators · Family-owned in Houston, TX</span><span><a href="/privacy/">Privacy</a> · <a href="/sitemap-index.xml">Sitemap</a></span></div>
  </div>
</footer>
