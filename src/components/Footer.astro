---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { installServices, maintainServices, servicePath } from '../data/services';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" aria-label={`${site.name} — home`} class="footer-logo"><Logo tone="light" /></a>
      <p>
        Family-owned yard drainage and flood mitigation for Greater Houston. {site.founded.story} — so your home
        doesn’t go through what ours did.
      </p>
      <ul role="list" class="footer-social">
        <li>
          <a href={site.social.facebook} rel="noopener" target="_blank" aria-label="Flood Mitigators on Facebook">
            <Icon name="facebook" size={20} />
          </a>
        </li>
        <li>
          <a href={site.social.instagram} rel="noopener" target="_blank" aria-label="Flood Mitigators on Instagram">
            <Icon name="instagram" size={20} />
          </a>
        </li>
      </ul>
    </div>

    <nav class="footer-col" aria-label="Installation services">
      <p class="footer-title">Build it right</p>
      <ul role="list">
        {installServices.map((s) => <li><a href={servicePath(s)}>{s.name}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Maintenance services">
      <p class="footer-title">Keep it flowing</p>
      <ul role="list">
        {maintainServices.map((s) => <li><a href={servicePath(s)}>{s.name}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Company">
      <p class="footer-title">Company</p>
      <ul role="list">
        <li><a href="/about-us/">About &amp; Manny</a></li>
        <li><a href="/service-areas/">Service Areas</a></li>
        <li><a href="/drainage-checkup/">Drainage Checkup</a></li>
        <li><a href="/flood-tips/">Hurricane-Season Checklist</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact-us/">Contact</a></li>
      </ul>
    </nav>

    <div class="footer-col footer-contact">
      <p class="footer-title">Talk to us</p>
      <ul role="list">
        <li>
          <a href={site.phone.href} class="footer-phone"><Icon name="phone" size={18} /> {site.phone.display}</a>
        </li>
        <li><a href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a></li>
        <li>
          <a href={site.address.mapsUrl} rel="noopener" target="_blank">
            <Icon name="pin" size={18} />
            <span>{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}</span>
          </a>
        </li>
        <li><span><Icon name="clock" size={18} /> {site.hours.label}</span></li>
        <li><span class="footer-emergency"><Icon name="siren" size={18} /> {site.hours.emergency}</span></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.legalName}. All rights reserved.</p>
    <p class="footer-legal">
      <a href="/privacy/">Privacy</a>
      <span aria-hidden="true">·</span>
      <a href="/sitemap-index.xml">Sitemap</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--deep);
    color: #b9c9d4;
    font-size: 0.95rem;
    padding-top: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1040px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr 1.3fr;
    }
    .footer-brand {
      grid-column: auto;
    }
  }
  .footer-logo {
    display: inline-block;
    text-decoration: none;
  }
  .footer-brand p {
    margin-top: 1.1rem;
    max-width: 38ch;
    line-height: 1.6;
  }
  .footer-social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .footer-social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--line-dark);
    color: #fff;
    transition: background-color 0.15s var(--ease);
  }
  .footer-social a:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .footer-title {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1rem;
  }
  .footer-col ul {
    display: grid;
    gap: 0.25rem;
  }
  .footer-col a,
  .footer-col span {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.55rem;
    padding-block: 0.3rem;
    color: #b9c9d4;
    text-decoration: none;
    line-height: 1.45;
  }
  .footer-col a:hover {
    color: #fff;
  }
  .footer-col :global(svg) {
    flex: none;
    margin-top: 0.1rem;
    color: var(--water-bright);
  }
  .footer-phone {
    font-family: var(--font-display);
    font-stretch: 105%;
    font-size: 1.15rem;
    font-weight: 800;
    color: #fff !important;
  }
  .footer-emergency {
    color: #fff !important;
    font-weight: 600;
  }
  .footer-emergency :global(svg) {
    color: var(--amber) !important;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.85rem;
    color: #8da3b3;
  }
  .footer-legal {
    display: flex;
    gap: 0.6rem;
  }
  .footer-legal a {
    color: #8da3b3;
    text-decoration: none;
  }
  .footer-legal a:hover {
    color: #fff;
  }
</style>
