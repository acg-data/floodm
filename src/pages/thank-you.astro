---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Base title="Thank you" description="We received your request." noindex>
  <section class="section ty">
    <div class="container-narrow ty-inner">
      <span class="ty-icon"><Icon name="check" size={40} strokeWidth={2.6} /></span>
      <h1>Got it — we’ll be in touch.</h1>
      <p class="lede">Your request is with our team. We’ll reach out the way you asked to set up your evaluation.</p>
      <p>If water is threatening your home right now, don’t wait — call <a href={site.phone.href}><strong>{site.phone.display}</strong></a>. {site.hours.emergency}.</p>
      <div class="ty-actions">
        <a href="/flood-tips/" class="btn">Hurricane-season checklist <Icon name="arrow-right" /></a>
        <a href="/" class="btn btn-ghost">Back to home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ty-inner {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    text-align: center;
  }
  .ty-icon {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--success);
    color: #fff;
    box-shadow: 0 0 0 10px rgba(28, 122, 76, 0.12);
  }
  h1 {
    font-size: var(--step-4);
  }
  .ty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
