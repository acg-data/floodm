---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Diagram from '../../components/Diagram.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { installServices, maintainServices, services, servicePath } from '../../data/services';
import { site } from '../../data/site';
import { breadcrumbLd } from '../../lib/schema';

const crumbs = [{ name: 'Services', href: '/services/' }];
const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Flood Mitigators services',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${site.url}${servicePath(s)}` })),
};
---

<Base
  title="Drainage & Flood Mitigation Services in Houston"
  description="French drains, sump pumps, culverts, yard & foundation drainage, drain and stormwater cleaning, culvert cleaning and hydro jetting across Greater Houston."
  jsonLd={[breadcrumbLd(crumbs), listLd]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Services"
    title="Every way water leaves a Houston yard — handled."
    lede="We build new drainage systems and keep existing ones flowing. One family-owned team, one designed plan, one warranty on installations."
  />

  <section class="section">
    <div class="container">
      <div class="group-head">
        <span class="gh-icon"><Icon name="hardhat" size={26} /></span>
        <div>
          <h2>Build it right</h2>
          <p class="muted">New systems designed for your lot — backed by our {site.warranty.long}.</p>
        </div>
      </div>
      <div class="grid grid-2">
        {installServices.map((s) => <ServiceCard service={s} />)}
      </div>

      <div class="group-head group-2">
        <span class="gh-icon"><Icon name="sparkle" size={26} /></span>
        <div>
          <h2>Keep it flowing</h2>
          <p class="muted">Cleaning and maintenance for any drainage system, whoever installed it.</p>
        </div>
      </div>
      <div class="grid grid-2">
        {maintainServices.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="section section-mist">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow">One system, not a patchwork</p>
        <h2>The best results come from designing it all together.</h2>
        <p class="lede">
          Most yards need more than one fix. We look at roof runoff, low spots, neighboring lots and your outlet options at
          the same time — then design a single system that handles every gallon.
        </p>
        <a href="/contact-us/#quote" class="btn">Start with an evaluation <Icon name="arrow-right" /></a>
      </div>
      <Diagram name="yard" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>Same four steps, every job.</h2>
      </div>
      <ProcessSteps />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .group-head {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .group-2 {
    margin-top: 3.5rem;
  }
  .group-head h2 {
    font-size: var(--step-3);
  }
  .gh-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 16px;
    background: var(--amber);
    color: var(--amber-ink);
  }
</style>
