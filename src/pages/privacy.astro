---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
---

<Base title="Privacy" description="How Flood Mitigators handles the information you send us." noindex>
  <PageHero crumbs={[{ name: 'Privacy', href: '/privacy/' }]} title="Privacy" lede="Plain-English summary of how we handle your information." />
  <section class="section">
    <div class="container-narrow prose">
      <h2>What we collect</h2>
      <p>When you request an evaluation, we receive what you choose to share: your name, phone number, email, property location, and details or photos about your drainage problem.</p>
      <h2>How we use it</h2>
      <p>Only to respond to your request, evaluate your property, prepare your proposal and provide service. We don’t sell your information.</p>
      <h2>Your choices</h2>
      <p>To update or delete the information you’ve sent us, email <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href={site.phone.href}>{site.phone.display}</a>.</p>
      <h2>This website</h2>
      <p>This site doesn’t use advertising cookies. The Hurricane-Season Checklist stores your checkmarks in your own browser only.</p>
    </div>
  </section>
</Base>
