---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { generalFaqs } from '../data/faqs';
import { services, servicePath } from '../data/services';
import { site } from '../data/site';
import { breadcrumbLd, faqLd } from '../lib/schema';

const crumbs = [{ name: 'FAQ', href: '/faq/' }];
const general = generalFaqs.flatMap((g) => g.items);
const seen = new Set(general.map((f) => f.q));
const serviceGroups = services
  .map((s) => ({ s, items: s.faqs.filter((f) => !seen.has(f.q)) }))
  .filter((g) => g.items.length);
const all = [...general, ...serviceGroups.flatMap((g) => g.items)];
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<Base
  title="Drainage & Flood Mitigation FAQ"
  description="Answers about French drains, sump pumps, culverts, drain cleaning, hydro jetting, warranties and evaluations from Houston’s family-owned drainage team."
  jsonLd={[breadcrumbLd(crumbs), faqLd(all)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="FAQ"
    title="Drainage questions, answered straight."
    lede="What Houston homeowners ask us most — about yards that flood, the systems that fix them, and how we work."
  />

  <section class="section">
    <div class="container faq-layout">
      <nav class="toc" aria-label="FAQ topics">
        <p class="toc-title">Topics</p>
        <ul role="list">
          {generalFaqs.map((g) => <li><a href={`#${slug(g.topic)}`}>{g.topic}</a></li>)}
          {serviceGroups.map(({ s }) => <li><a href={`#${s.slug}`}>{s.name}</a></li>)}
        </ul>
        <div class="toc-cta">
          <p>Still have a question?</p>
          <a href={site.phone.href} class="btn btn-block"><Icon name="phone" /> {site.phone.display}</a>
        </div>
      </nav>
      <div class="faq-groups">
        {generalFaqs.map((g) => (
          <section id={slug(g.topic)} class="faq-group">
            <h2>{g.topic}</h2>
            <FaqList items={g.items} />
          </section>
        ))}
        {serviceGroups.map(({ s, items }) => (
          <section id={s.slug} class="faq-group">
            <h2>{s.name}</h2>
            <FaqList items={items} />
            <a href={servicePath(s)} class="link-arrow">More about {s.name.toLowerCase()} <Icon name="arrow-right" /></a>
          </section>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .faq-layout {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 980px) {
    .faq-layout {
      grid-template-columns: 260px 1fr;
      gap: 4rem;
    }
    .toc {
      position: sticky;
      top: calc(var(--header-h) + 60px);
    }
  }
  .toc-title {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .toc ul {
    display: grid;
    gap: 0.1rem;
    border-left: 2px solid var(--line);
  }
  .toc a {
    display: block;
    padding: 0.4rem 0 0.4rem 1rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.95rem;
  }
  .toc a:hover {
    color: var(--water-ink);
    border-left-color: var(--water);
  }
  .toc-cta {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 1.1rem;
    border-radius: var(--radius);
    background: var(--mist);
    font-weight: 650;
  }
  @media (max-width: 979px) {
    .toc ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      border: 0;
    }
    .toc a {
      padding: 0.45rem 0.85rem;
      margin: 0;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--card);
      font-size: 0.88rem;
    }
    .toc-cta {
      display: none;
    }
  }
  .faq-groups {
    display: grid;
    gap: 3.5rem;
  }
  .faq-group {
    display: grid;
    gap: 1rem;
    scroll-margin-top: calc(var(--header-h) + 60px);
  }
  .faq-group h2 {
    font-size: var(--step-3);
  }
</style>
