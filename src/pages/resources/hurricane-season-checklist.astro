---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FinalCta from '../../components/FinalCta.astro';
import { breadcrumbLd } from '../../lib/schema';
const crumbs = [{ name: 'Resources', href: '/resources/' }, { name: 'Hurricane-season checklist', href: '/resources/hurricane-season-checklist/' }];
const phases = [
  { id: 'season', icon: 'i-list', when: 'Before June 1', title: 'Before the season', items: [
    'Clean gutters and make sure every downspout sends water well away from the slab',
    'Clear leaves and mulch from catch basin grates and pop-up emitters',
    'Test your sump pump: pour water into the basin and watch it start, pump and stop',
    'Look through your driveway culvert — you should see daylight end to end',
    'Walk the yard after a normal rain and note where water stands',
    'Keep the storm inlet in front of your home clear of leaves and yard debris',
  ] },
  { id: 'storm', icon: 'i-storm', when: 'Days before a storm', title: 'When a storm is coming', items: [
    'Re-check grates, emitters and inlets — storms push debris into them fast',
    'Confirm the sump discharge line is connected and its outlet is clear',
    'Move vehicles and valuables to higher ground if your street is known to flood',
    'Sign up for local alerts, like the Harris County Flood Warning System',
  ] },
  { id: 'during', icon: 'i-siren', when: 'Stay safe', title: 'During the storm', items: [
    'Never walk or drive through floodwater — turn around, don’t drown',
    'From safely indoors, take video of where water flows and collects; it helps design the fix',
    'If water is threatening your home, call (281) 849-1082 for 24/7 emergency response',
  ] },
  { id: 'after', icon: 'i-check', when: 'Once it’s safe', title: 'After the storm', items: [
    'Clear storm debris from grates, inlets and the culvert',
    'Check for washed-out soil or exposed slab edges around the foundation',
    'Make sure the sump pump is still cycling normally',
    'Get a free Flood Snapshot and book an assessment if water reached places it shouldn’t',
  ] },
];
const howTo = { '@context': 'https://schema.org', '@type': 'HowTo', name: 'Hurricane-season drainage checklist for Houston homes', step: phases.flatMap((p) => p.items.map((text) => ({ '@type': 'HowToStep', name: p.title, text }))) };
---
<Base title="Hurricane-Season Drainage Checklist" description="Get your Houston yard drainage ready for hurricane season (June 1–November 30): what to check before the season, before a storm, during it and after." jsonLd={[breadcrumbLd(crumbs), howTo]}>
  <PageHero crumbs={crumbs} eyebrow="Checklist · Hurricane season" headline={['Ready your drainage', 'before June 1.']} lede="Atlantic hurricane season runs June 1 through November 30. A few hours of prep can be the difference between a wet lawn and water at the door.">
    <div class="hero-actions"><button class="btn btn-primary" type="button" data-print>Print the checklist <svg><use href="#i-arrow"/></svg></button><span class="progress-note" data-progress aria-live="polite"></span></div>
  </PageHero>
  <section class="section band-white">
    <div class="wrap">
      <div class="checklist-grid" data-checklist>
        {phases.map((p) => (
          <section class="cl">
            <div class="cl-head"><svg aria-hidden="true"><use href={`#${p.icon}`}/></svg><div><small>{p.when}</small><h2>{p.title}</h2></div></div>
            <ul>{p.items.map((it, i) => <li><label><input type="checkbox" data-key={`${p.id}-${i}`} /><span class="box" aria-hidden="true"><svg><use href="#i-check"/></svg></span><span class="txt">{it}</span></label></li>)}</ul>
          </section>
        ))}
      </div>
      <p class="note" style="margin-top:20px"><svg aria-hidden="true"><use href="#i-info"/></svg><span>Your checkmarks are saved on this device only. Flood alerts: <a href="https://www.harriscountyfws.org/" target="_blank" rel="noopener">Harris County Flood Warning System</a>.</span></p>
    </div>
  </section>
  <FinalCta title="Want us to check it for you?" body="Start with a free Snapshot of your address, or book an assessment before the season starts." />
</Base>
<script>
  const KEY = 'fm-hurricane-checklist';
  const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-checklist] input[data-key]')];
  const progress = document.querySelector<HTMLElement>('[data-progress]');
  let saved: Record<string, boolean> = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch { saved = {}; }
  const update = () => { const n = boxes.filter((b) => b.checked).length; if (progress) progress.textContent = n ? `${n} of ${boxes.length} done` : ''; };
  boxes.forEach((b) => {
    b.checked = Boolean(saved[b.dataset.key!]);
    b.addEventListener('change', () => { saved[b.dataset.key!] = b.checked; try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch { /* storage unavailable */ } update(); });
  });
  update();
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
