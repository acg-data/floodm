---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { services } from '../data/services';
import { faqLd } from '../lib/schema';
import { site } from '../data/site';
import { onsiteFaqs } from '../data/onsite-faqs';
import HomeHero from '../components/HomeHero.astro';
import InteractiveHome from '../components/InteractiveHome.astro';
import Reviews from '../components/Reviews.astro';
import MiniCredentials from '../components/MiniCredentials.astro';

const featuredSlugs = ['french-drain-installation-houston', 'sump-pump-installation-houston', 'grading-drainage-houston', 'downspout-catch-basin-houston'];
const featuredServices = featuredSlugs.map(slug => services.find(service => service.slug === slug)!);
const faqs = [onsiteFaqs[0], onsiteFaqs[2], onsiteFaqs[4], onsiteFaqs[7]];

---

<Base
  title="Houston Yard Drainage & Flood Mitigation | Flood Mitigators"
  rawTitle
  description="Yard drainage and flood mitigation for Houston homes. French drains, grading, downspout lines and drain cleaning from Manny’s local team. Call (281) 849-1082."
  jsonLd={[faqLd(faqs)]}
>
  <HomeHero />

  <MiniCredentials />
  <InteractiveHome />

  <section class="section services home-services" id="services">
    <div class="wrap">
      <div class="section-head">
        <h2>The right fix<br>for your yard.</h2>
        <p class="lede">We assess your property in person, then design around the way water moves.</p>
      </div>
      <div class="svc-grid">
        {featuredServices.map((s) => <ServiceCard service={s} />)}
      </div>
      <div class="home-services-bottom"><p>Need cleaning, repairs or another drainage service?</p><a class="link-arrow" href="/services/">See all drainage services <svg aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
    </div>
  </section>

  <Reviews compact />

  <section class="section process" id="process">
    <div class="wrap">
      <div class="section-head">
        <h2>A clear plan.<br>A local crew to build it.</h2>
      </div>
      <Steps />
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-side">
        <h2>Houston drainage questions, answered.</h2>
        <p>Tell us where water collects and arrange an onsite visit with our Houston drainage team. Call or text <a href={site.phone.href}>{site.phone.display}</a>.</p>
        <div class="hero-actions"><button class="btn btn-primary" data-book="assessment">Get a drainage assessment <svg><use href="#i-arrow"/></svg></button><a class="link-arrow" href="/faq/">All FAQs <svg><use href="#i-arrow"/></svg></a></div>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <FinalCta title="Let’s get your Houston yard draining." body="Tell Manny’s team where the water collects. We’ll help you work out the next step." book="assessment" serviceFirst />
</Base>
