---
import Base from '../layouts/Base.astro';
import SnapshotForm from '../components/SnapshotForm.astro';
import Trust from '../components/Trust.astro';
import Ladder from '../components/Ladder.astro';
import ServiceCard from '../components/ServiceCard.astro';
import MiniCard from '../components/MiniCard.astro';
import Steps from '../components/Steps.astro';
import Local from '../components/Local.astro';
import Runoff from '../components/Runoff.astro';
import Crew from '../components/Crew.astro';
import Manny from '../components/Manny.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import Credentials from '../components/Credentials.astro';
import Aftercare from '../components/Aftercare.astro';
import { services } from '../data/services';
import { areas, areaPath } from '../data/areas';
import { guides, tools, guidePath } from '../data/resources';
import { faqLd } from '../lib/schema';
import { site } from '../data/site';
import { houstonCoverage } from '../data/houston';
import type { Faq as FaqItem } from '../data/types';

const photoServices = services.filter((s) => s.photo);
const otherServices = services.filter((s) => !s.photo);

const faqs: FaqItem[] = [
  { q: 'Can you assess my property remotely?', a: 'Yes. Our Snapshot and Flood Intelligence reports are built from your address, and the Expert Mitigation Plan is a video call. Virtual or onsite drainage assessments are also available; tell us what you need when you contact the team.' },
  { q: 'Is the Flood Snapshot really free?', a: 'Yes. Enter your address and email and we send it. No card and no obligation. If it raises questions, the Flood Intelligence report answers them in detail.' },
  { q: 'How is Flood Intelligence different from the Snapshot?', a: 'The Snapshot tells you whether you have a problem. Flood Intelligence tells you why, with flood and rainfall history near your block, how water moves across your lot, and a ranked list of fixes.' },
  { q: 'What drainage problems do you help with?', a: 'Standing water in the yard, water pooling at the foundation, soggy side yards, overflowing gutters and downspouts, water reaching the garage or patio, and runoff coming from a neighbor’s lot.' },
  { q: 'Will yard drainage stop street or bayou flooding?', a: 'Not always, and we’ll tell you so. Drains handle the water that falls on and runs across your lot. If floodwater comes from the street or a bayou, your report covers what helps in that case and what won’t.' },
  { q: 'What happens after the assessment?', a: 'You keep the report either way. If you want the work done, we turn your plan into a fixed install scope, schedule the crew, and handle the job from layout to cleanup.' },
  { q: 'Do you offer a warranty?', a: 'Yes. Drainage systems we install are backed by a 3-year parts and labor limited warranty. Your install scope spells out exactly what it covers.' },
  { q: 'What if water is coming in right now?', a: 'Call or text (281) 849-1082. We offer 24/7 emergency response. Regular office hours are Monday to Friday, 6 am to 6 pm Central.' },
  { q: 'What areas do you serve?', a: 'Greater Houston and the surrounding communities, from the Inner Loop out to Katy, Cypress, The Woodlands, Kingwood, Sugar Land and Pearland. Not sure about your street? Call or text and ask.' },
];
---

<Base
  title="Houston Yard Drainage & Flood Mitigation | Flood Mitigators"
  rawTitle
  description="Yard drainage and flood mitigation for Houston homes. French drains, grading, downspout lines and drain cleaning from Manny’s local team. Call (281) 849-1082."
  jsonLd={[faqLd(faqs)]}
>
  <section class="hero houston-hero">
    <div class="wrap">
      <div class="hero-copy">
        <h1><span>Yard drainage &amp;</span><span>flood mitigation</span><span class="accent">in Houston.</span></h1>
        <p class="lede">Soggy yard after every storm? Water against the slab? Manny&rsquo;s Houston team designs and installs drainage around your soil, your street and the way water moves across your lot.</p>
        <div class="hero-actions">
          <button class="btn btn-primary" data-book="install">Get a drainage assessment <svg><use href="#i-arrow"/></svg></button>
          <a class="link-arrow" href={site.phone.href}><svg aria-hidden="true"><use href="#i-phone"/></svg>{site.phone.display}</a>
        </div>
        <ul class="houston-hero-proof" aria-label="About our Houston team"><li>Family-owned in Houston</li><li>Our own installation crew</li><li>3-year limited warranty</li></ul>
        <p class="houston-hero-note">Serving Houston, Katy, Cypress, Sugar Land, Pearland and the surrounding communities. <a href="#areas">Find your neighborhood</a></p>
      </div>

      <div class="hero-visual">
        <div class="hero-photo"><img src="/assets/source/van-in-action.webp" width="1440" height="1080" fetchpriority="high" alt="The Flood Mitigators van at work beside a Houston-area home"></div>
        <aside class="snapshot houston-plan" aria-label="Our Houston installation team">
          <div class="snap-top"><span class="snap-tag">Houston-operated</span><svg aria-hidden="true"><use href="#i-house"/></svg></div>
          <h2>Your local crew.<br>Every step of the way.</h2>
          <p>From the first assessment to installation, testing and ongoing care.</p>
          <a class="link-arrow" href="/our-work/">See our crew in action <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
        </aside>
      </div>
    </div>
  </section>

  <Trust />
  <div class="certified-strip"><div class="wrap"><img src="/assets/source/nds-certified.webp" width="600" height="611" alt="NDS Professional Drainage Certified Contractor" /><p><strong>NDS Professional Drainage Certified Contractor</strong><span>Careful design. Proven components. A Houston team that stands behind the work.</span></p><a href="#credentials">Our credentials <svg aria-hidden="true"><use href="#i-arrow"/></svg></a></div></div>

  <section class="section services" id="services">
    <div class="wrap">
      <div class="section-head">
        <h2>Drainage solutions for<br>Houston homes.</h2>
        <p class="lede">French drains, downspout lines, grading and more. We look at where the water starts, where it collects and where it can go, then build a system that works together.</p>
      </div>
      <div class="svc-grid">
        {photoServices.map((s) => <ServiceCard service={s} />)}
      </div>
      <div class="svc-more">
        <div class="svc-more-head"><h3>Keep it flowing</h3><p>Culverts, cleaning and jetting for any drainage system, whoever installed it.</p></div>
        <div class="svc-more-grid">
          {otherServices.map((s) => <MiniCard service={s} />)}
        </div>
      </div>
    </div>
  </section>

  <Local />

  <section class="section houston-areas" id="areas" aria-labelledby="areasH">
    <div class="wrap">
      <div class="houston-areas-intro">
        <div class="section-head">
          <h2 id="areasH">Houston is home.<br>Your neighborhood matters.</h2>
          <p class="lede">A yard in the Heights has a different drainage story from a lot in Katy. Find your community for local concerns, nearby waterways and options for your property.</p>
        </div>
        <a class="link-arrow" href="/service-areas/">Explore Greater Houston coverage <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
      <div class="houston-coverage">
        {houstonCoverage.map((group) => (
          <div class="houston-region">
            <div><h3>{group.name}</h3><p>{group.description}</p></div>
            <ul>{group.slugs.map((slug) => {
              const area = areas.find((a) => a.slug === slug)!;
              return <li><a href={areaPath(area)}>{area.name}<svg aria-hidden="true"><use href="#i-arrow"/></svg></a></li>;
            })}</ul>
          </div>
        ))}
      </div>
      <p class="houston-coverage-note">Don&rsquo;t see your street? <a href={site.phone.href}>Call or text {site.phone.display}</a> to check coverage.</p>
    </div>
  </section>

  <section class="section process" id="process">
    <div class="wrap">
      <div class="section-head">
        <h2>A clear plan.<br>A local crew to build it.</h2>
      </div>
      <Steps />
    </div>
  </section>

  <Crew />
  <ProjectGallery />
  <Manny />
  <Aftercare />
  <div id="credentials"><Credentials /></div>

  <section class="section reports" id="reports">
    <div class="wrap">
      <div class="section-head">
        <h2>Know more about<br>your Houston property.</h2>
        <p class="lede">Planning ahead, buying a home or wondering what your flood zone means? Start with a free Snapshot, explore the full report or talk through a mitigation plan.</p>
      </div>
      <Ladder />
      <div class="houston-snapshot-form"><h3>Start with your Houston-area address.</h3><SnapshotForm /></div>
    </div>
  </section>

  <Runoff />

  <section class="section faq" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-side">
        <h2>Houston drainage questions, answered.</h2>
        <p>Something else on your mind? Tell us in the booking form and a specialist will reply, or call or text <a href={site.phone.href}>{site.phone.display}</a>.</p>
        <div class="hero-actions"><button class="btn btn-primary" data-book="install">Get a drainage assessment <svg><use href="#i-arrow"/></svg></button><a class="link-arrow" href="/faq/">All FAQs <svg><use href="#i-arrow"/></svg></a></div>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <section class="section band-white" aria-labelledby="resH">
    <div class="wrap">
      <div class="section-head">
        <h2 id="resH">A homeowner&rsquo;s guide<br>to Houston rain.</h2>
        <p class="lede">Plain-English guides and free tools for Houston homeowners. No sign-up.</p>
      </div>
      <div class="res-grid">
        {guides.slice(0, 3).map((g) => (
          <a class="res" href={guidePath(g.slug)}><svg aria-hidden="true"><use href={`#${g.icon}`}/></svg><h3>{g.title}</h3><p>{g.summary}</p><span class="link-arrow">Read the guide <svg><use href="#i-arrow"/></svg></span></a>
        ))}
        {tools.map((t) => (
          <a class="res" href={t.href}><svg aria-hidden="true"><use href={`#${t.icon}`}/></svg><h3>{t.title}</h3><p>{t.summary}</p><span class="link-arrow">Open the tool <svg><use href="#i-arrow"/></svg></span></a>
        ))}
      </div>
    </div>
  </section>

  <FinalCta title="Let’s get your Houston yard draining." body="Tell Manny’s team where the water collects. We’ll help you work out the next step." book="install" serviceFirst />
</Base>
