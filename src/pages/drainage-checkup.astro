---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DrainageCheckup from '../components/DrainageCheckup.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbLd } from '../lib/schema';

const crumbs = [{ name: 'Drainage Checkup', href: '/drainage-checkup/' }];
---

<Base
  title="Drainage Checkup — What Does Your Yard Need?"
  description="Answer two quick questions about your Houston yard and get a recommendation: French drain, sump pump, yard drainage, culvert work, drain cleaning or hydro jetting."
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="60-second Drainage Checkup"
    title="What does your yard actually need?"
    lede="Tap what you’re seeing, answer one question, and we’ll point you to the right fix. Send the results to our team in one click."
  />
  <section class="section">
    <div class="container">
      <DrainageCheckup />
    </div>
  </section>
  <CtaBand title="Rather talk it through?" body="Call or text and describe what you’re seeing — or send photos and video. We’ll tell you honestly what it needs." />
</Base>
