---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DrainageCheckup from '../components/DrainageCheckup.astro';
import FinalCta from '../components/FinalCta.astro';
import { breadcrumbLd } from '../lib/schema';
const crumbs = [{ name: 'Resources', href: '/resources/' }, { name: 'Drainage checkup', href: '/drainage-checkup/' }];
---
<Base title="Drainage Checkup: What Does Your Yard Need?" description="Tap what you're seeing in your Houston yard and answer one question. We'll point you to the likely fix — French drain, sump pump, grading, downspouts and more." jsonLd={[breadcrumbLd(crumbs)]}>
  <PageHero crumbs={crumbs} eyebrow="60-second drainage checkup" headline={['What does your yard', 'actually need?']} lede="Tap what you’re seeing, answer one question, and we’ll point you to the likely fix. Send the results to our team in one tap." />
  <section class="section band-white"><div class="wrap"><DrainageCheckup /></div></section>
  <FinalCta title="Rather talk it through?" body="Call or text and describe what you’re seeing, or start with a free Snapshot of your address." />
</Base>
