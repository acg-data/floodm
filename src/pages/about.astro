---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Manny from '../components/Manny.astro';
import Crew from '../components/Crew.astro';
import Steps from '../components/Steps.astro';
import Local from '../components/Local.astro';
import FinalCta from '../components/FinalCta.astro';
import Credentials from '../components/Credentials.astro';
import Aftercare from '../components/Aftercare.astro';
import { site } from '../data/site';
import { breadcrumbLd } from '../lib/schema';

const crumbs = [{ name: 'About', href: '/about/' }];
const story = [
  { mark: '2017', title: 'Harvey hits home', body: 'Hurricane Harvey floods Houston. Manny’s family and friends are among the households dealing with water where it never should have been.' },
  { mark: 'Then', title: 'Nothing on the market fits', body: 'The flood-prevention options available are ineffective, half-measures or priced out of reach. None start from how water actually moves on a Houston lot.' },
  { mark: 'So', title: 'We build our own', body: 'Manny and the team design and install their own drainage systems — built for Houston clay, flat ground and Gulf storms.' },
  { mark: 'Now', title: 'Flood Mitigators', body: 'Still family-owned and Houston-operated: remote flood assessments, a written plan, and our own crew to install it.' },
];
const values = [
  { icon: 'i-house', title: 'Start with the property', body: 'Every recommendation is built from your address, your grade and how water moves on your lot.' },
  { icon: 'i-doc', title: 'Plan before we dig', body: 'You get a written plan and a fixed install scope before any trench is dug.' },
  { icon: 'i-shield', title: 'Stand behind the work', body: `Installations carry our ${site.warranty}.` },
  { icon: 'i-siren', title: 'Be there when it storms', body: 'We offer 24/7 emergency response when water is threatening your home.' },
];
const aboutLd = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About Flood Mitigators', url: `${site.url}/about/`, about: { '@id': `${site.url}/#business` } };
---

<Base title="About Flood Mitigators & Owner Manny" description="Flood Mitigators is a family-owned Houston flood assessment and drainage company started by owner Manny after Hurricane Harvey. Meet the team and how we work." jsonLd={[aboutLd, breadcrumbLd(crumbs)]}>
  <PageHero crumbs={crumbs} eyebrow="About Flood Mitigators" headline={['Family-owned.', 'Born after Harvey.']} lede="We started Flood Mitigators because we lived through the flood and couldn’t find a fix worth trusting. So we built one.">
    <div class="hero-actions">
      <a class="btn btn-primary" href={site.phone.href}><svg><use href="#i-phone"/></svg>Call {site.phone.display}</a>
      <button class="btn btn-ghost" data-book="">Book an assessment <svg><use href="#i-arrow"/></svg></button>
    </div>
    <Fragment slot="visual"><div class="visual-photo"><img src="/assets/source/van-in-action.webp" width="1440" height="1080" alt="Flood Mitigators service van at a residential property" fetchpriority="high" /></div></Fragment>
  </PageHero>

  <Manny headingLevel="h2" />

  <section class="section runoff" aria-labelledby="storyH">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">Our story</span><h2 id="storyH">From one family’s flood to a Houston drainage team.</h2></div>
      <div class="calc-stats" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))">
        {story.map((s) => <div class="stat"><span class="k">{s.mark}</span><span class="v" style="font-size:1.3rem">{s.title}</span><span class="s">{s.body}</span></div>)}
      </div>
    </div>
  </section>

  <Crew />

  <section class="section band-ice">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">How we work</span><h2>What you can count on.</h2></div>
      <div class="points">
        {values.map((v, i) => <div class="point"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{v.title}</h3><p>{v.body}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section process">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">Our process</span><h2>From standing water to a clear plan.</h2></div>
      <Steps />
    </div>
  </section>

  <Local />
  <Credentials />
  <Aftercare />

  <section class="section band-white">
    <div class="wrap two-col">
      <div class="section-head" style="margin:0"><span class="eyebrow">Follow the work</span><h2>See our latest projects.</h2><p class="lede">Installs in progress, before-and-afters and storm-season tips.</p></div>
      <div class="hero-actions" style="align-self:center">
        <a class="btn btn-primary" href={site.social.instagram} target="_blank" rel="noopener"><svg><use href="#i-ig"/></svg>Instagram</a>
        <a class="btn btn-primary" href={site.social.facebook} target="_blank" rel="noopener"><svg><use href="#i-fb"/></svg>Facebook</a>
      </div>
    </div>
  </section>

  <FinalCta title={`Talk to ${site.owner.name}’s team.`} body="Start with a free Snapshot of your address, or book an assessment and we’ll take it from there." />
</Base>
