---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { breadcrumbLd } from '../lib/schema';

const crumbs = [{ name: 'Hurricane-Season Checklist', href: '/flood-tips/' }];

const phases = [
  {
    id: 'season',
    icon: 'calendar',
    title: 'Before the season',
    when: 'Before June 1',
    items: [
      'Clean gutters and make sure every downspout discharges well away from the slab',
      'Clear leaves and mulch from catch basin grates and pop-up emitters',
      'Test your sump pump: pour water into the basin and watch it start, pump and stop',
      'Look through your driveway culvert — you should see daylight end to end',
      'Walk the yard after a normal rain and note where water stands',
      'Keep the storm inlet in front of your home clear of leaves and yard debris',
    ],
  },
  {
    id: 'storm',
    icon: 'rain',
    title: 'When a storm is coming',
    when: 'Days before landfall',
    items: [
      'Re-check grates, emitters and inlets — storms push debris into them fast',
      'Confirm the sump discharge line is connected and its outlet is clear',
      'Move vehicles and valuables to higher ground if your street is known to flood',
      'Sign up for local alerts, like the Harris County Flood Warning System',
    ],
  },
  {
    id: 'during',
    icon: 'siren',
    title: 'During the storm',
    when: 'Stay safe',
    items: [
      'Never walk or drive through floodwater — turn around, don’t drown',
      'From safely indoors, take video of where water flows and collects — it helps design the fix',
      'If water is threatening your home, call us for 24/7 emergency response',
    ],
  },
  {
    id: 'after',
    icon: 'sparkle',
    title: 'After the storm',
    when: 'Once it’s safe',
    items: [
      'Clear storm debris from grates, inlets and the culvert',
      'Check for washed-out soil or exposed slab edges around the foundation',
      'Make sure the sump pump is still cycling normally',
      'Schedule a drainage evaluation if water reached places it shouldn’t',
    ],
  },
];

const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Hurricane-season drainage checklist for Houston homes',
  step: phases.flatMap((p) => p.items.map((text) => ({ '@type': 'HowToStep', name: p.title, text }))),
};
---

<Base
  title="Hurricane-Season Drainage Checklist for Houston"
  description="A practical checklist to get your Houston yard drainage ready for hurricane season — before June 1, before a storm, during and after."
  jsonLd={[breadcrumbLd(crumbs), howTo]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Flood tips"
    title="The hurricane-season drainage checklist."
    lede="Atlantic hurricane season runs June 1 through November 30. A few hours of prep can be the difference between a wet lawn and water at the door."
  >
    <div class="hero-tools on-dark">
      <button type="button" class="btn btn-ghost" data-print><Icon name="clipboard" /> Print checklist</button>
      <span class="progress" data-progress aria-live="polite"></span>
    </div>
  </PageHero>

  <section class="section">
    <div class="container phases" data-checklist>
      {phases.map((p) => (
        <section class="phase card" data-reveal>
          <header>
            <span class="p-icon"><Icon name={p.icon} size={24} /></span>
            <div>
              <p class="p-when">{p.when}</p>
              <h2>{p.title}</h2>
            </div>
          </header>
          <ul role="list">
            {p.items.map((item, i) => (
              <li>
                <label>
                  <input type="checkbox" data-key={`${p.id}-${i}`} />
                  <span class="box" aria-hidden="true"><Icon name="check" size={14} strokeWidth={3} /></span>
                  <span class="txt">{item}</span>
                </label>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p class="container note muted">
      Your checkmarks are saved on this device only. Alerts: <a href="https://www.harriscountyfws.org/" target="_blank" rel="noopener">Harris County Flood Warning System</a>.
    </p>
  </section>

  <CtaBand title="Want a pro to check it for you?" body={`We’ll evaluate your yard before the season — on site or virtually — and fix what needs fixing. ${site.hours.emergency}.`} />
</Base>

<style>
  .hero-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .progress {
    color: #c4d4df;
    font-weight: 600;
  }
  .phases {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
  }
  .phase {
    padding: clamp(1.3rem, 1rem + 1vw, 2rem);
  }
  .phase header {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .p-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 14px;
    background: var(--navy);
    color: var(--water-bright);
  }
  .p-when {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--water-ink);
  }
  .phase h2 {
    font-size: var(--step-2);
  }
  .phase ul {
    display: grid;
    gap: 0.25rem;
  }
  .phase label {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 0.8rem;
    align-items: start;
    padding: 0.6rem 0.5rem;
    border-radius: 10px;
    cursor: pointer;
    position: relative;
  }
  .phase label:hover {
    background: var(--paper);
  }
  .phase input {
    position: absolute;
    opacity: 0;
    width: 26px;
    height: 26px;
    margin: 0;
  }
  .box {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    border: 2px solid var(--line-strong);
    color: transparent;
    background: #fff;
    transition: all 0.15s var(--ease);
  }
  .phase input:checked + .box {
    background: var(--success);
    border-color: var(--success);
    color: #fff;
  }
  .phase input:checked ~ .txt {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: rgba(12, 26, 36, 0.35);
  }
  .phase input:focus-visible + .box {
    outline: 3px solid var(--water-bright);
    outline-offset: 2px;
  }
  .txt {
    line-height: 1.5;
  }
  .note {
    margin-top: 1.5rem;
    font-size: 0.9rem;
  }
  @media print {
    .phase {
      break-inside: avoid;
      box-shadow: none;
    }
    .hero-tools {
      display: none;
    }
  }
</style>

<script>
  const KEY = 'fm-hurricane-checklist';
  const root = document.querySelector<HTMLElement>('[data-checklist]');
  const progress = document.querySelector<HTMLElement>('[data-progress]');
  const boxes = [...(root?.querySelectorAll<HTMLInputElement>('input[data-key]') ?? [])];

  let saved: Record<string, boolean> = {};
  try {
    saved = JSON.parse(localStorage.getItem(KEY) ?? '{}');
  } catch {
    saved = {};
  }
  const update = () => {
    const done = boxes.filter((b) => b.checked).length;
    if (progress) progress.textContent = done ? `${done} of ${boxes.length} done` : '';
  };
  boxes.forEach((b) => {
    b.checked = Boolean(saved[b.dataset.key!]);
    b.addEventListener('change', () => {
      saved[b.dataset.key!] = b.checked;
      try {
        localStorage.setItem(KEY, JSON.stringify(saved));
      } catch {
        /* storage unavailable — checkmarks just won't persist */
      }
      update();
    });
  });
  update();
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
